{
  "name": "@citshe/cli",
  "version": "0.3.0",
  "description": "Thin local CLI for the citshe panel — attach to Claude Code sessions running on your VPS from your local terminal.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "citshe",
    "claude",
    "claude-code",
    "cli",
    "terminal"
  ],
  "homepage": "https://github.com/mitshe/citshe/tree/master/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitshe/citshe.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mitshe/citshe/issues"
  },
  "bin": {
    "citshe": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18"
  }
}
