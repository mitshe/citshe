# citshe production env — copy to `.env` next to docker-compose.yml, fill in,
# then `chmod 600 .env`. NEVER commit the filled-in file.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate the three secrets with:  openssl rand -hex 32   (POSTGRES_PASSWORD
# may be shorter, e.g. `openssl rand -hex 24`).

# The public hostname you point the Cloudflare Tunnel at (no scheme).
PANEL_DOMAIN=panel.example.com

# Postgres password (used to build DATABASE_URL inside the stack).
POSTGRES_PASSWORD=change-me

# Encrypts your connected provider keys (AES-256-GCM). Must stay stable —
# changing it orphans previously encrypted data. openssl rand -hex 32
ENCRYPTION_KEY=change-me

# Signs auth (JWT) tokens. openssl rand -hex 32
JWT_SECRET=change-me

# Cloudflare Tunnel token (the long string after `cloudflared service install`
# when you create the tunnel in the Cloudflare Zero Trust dashboard).
TUNNEL_TOKEN=change-me

# Image tags to pull from GHCR (leave as latest unless you pin a release).
IMAGE_TAG=latest
EXECUTOR_TAG=latest
